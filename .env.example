GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
PORT=8787

# Google Maps Embed API key (client-side, restrict by HTTP referrer in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth Client ID for "Sign in with Google" (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application)
VITE_GOOGLE_CLIENT_ID=
